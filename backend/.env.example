PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/lwallet?retryWrites=true&w=majority

# 0x Swap API key (get from dashboard.0x.org)
ZX_API_KEY=your_0x_api_key_here

# Your business wallet address to receive swap fees
FEE_WALLET_ADDRESS=0xYourBusinessWalletAddressHere

# BscScan API key (for transaction history)
BSCSCAN_API_KEY=YourBscScanApiKeyHere

# Ankr public RPC (or your NodeReal endpoint)
BSC_RPC_URL=https://rpc.ankr.com/bsc
BSC_RPC_BACKUP=https://bsc-dataseed.binance.org
