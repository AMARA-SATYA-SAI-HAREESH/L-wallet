{
  "expo": {
    "name": "L Wallet",
    "slug": "l-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101827"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lwallet.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101827"
      },
      "package": "com.lwallet.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow L Wallet to use Face ID for wallet access."
        }
      ]
    ],
    "scheme": "lwallet"
  }
}
