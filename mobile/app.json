{
  "expo": {
    "name": "L Wallet",
    "slug": "l-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lwallet.app"
    },
    "android": {
      "package": "com.lwallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#101827"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow L Wallet to use Face ID for wallet access."
        }
      ]
    ],
    "scheme": "lwallet"
  }
}
